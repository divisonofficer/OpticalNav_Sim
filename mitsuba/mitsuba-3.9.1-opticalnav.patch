+/// The RGB lanes of a colour (RGBN: without its near-infrared lane)
+template <typename Float, size_t N> Color<Float, 3> rgb_lanes(const Color<Float, N> &c) {
+    static_assert(N == 3 || N == 4, "rgb_lanes(): an RGB or RGBN colour");
