+/**
+ * \brief Mean of a tabulated spectrum over the near-infrared band (800-900 nm, as far as the data
+ * reaches; else its longest-wavelength value): the near-infrared lane of an RGBN colour made from
+ * spectral data, such as a conductor's complex index of refraction.
+ */
+inline double spectrum_list_nir(const std::vector<double> &wavelengths, const std::vector<double> &values) {
+    double sum = 0.0;
+    size_t count = 0;
+    for (size_t i = 0; i < wavelengths.size(); ++i) {
+        if (wavelengths[i] >= 800.0 && wavelengths[i] <= 900.0) {
+            sum += values[i];
+            ++count;
+        }
+    }
+    if (count > 0)
+        return sum / (double) count;
+    size_t last = 0;
+    for (size_t i = 1; i < wavelengths.size(); ++i)
+        if (wavelengths[i] > wavelengths[last])
+            last = i;
+    return values.empty() ? 0.0 : values[last];
+}
