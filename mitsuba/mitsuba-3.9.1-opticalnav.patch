+++ b/src/bsdfs/measured_polarized_rgb.cpp
@@ -0,0 +1,369 @@
+#include <mitsuba/core/properties.h>
+#include <mitsuba/core/warp.h>
+#include <mitsuba/core/fresolver.h>
+#include <mitsuba/core/tensor.h>
+#include <mitsuba/core/distr_2d.h>
+#include <mitsuba/render/bsdf.h>
+#include <mitsuba/render/fresnel.h>
+#include <mitsuba/render/texture.h>
+#include <mitsuba/render/microfacet.h>
+
+/* Set the weight for cosine hemisphere sampling in relation to GGX sampling.
+   Set to 1.0 in order to fully fall back to cosine sampling. */
+#define COSINE_HEMISPHERE_PDF_WEIGHT 0.1f
+
+NAMESPACE_BEGIN(mitsuba)
+
+/**!
+
+.. _bsdf-measured_polarized_rgb:
+
+Channel-split RGB measured material (:monosp:`measured_polarized_rgb`)
+---------------------------------------------------------------------
+
+.. pluginparameters::
+
+ * - filename_r / filename_g / filename_b
+   - |string|
+   - Filenames of the three single-band pBRDF slices (e.g. 614 / 542 / 446 nm)
+     used to reconstruct the red, green and blue channels.
+
+ * - alpha_sample
+   - |float|
+   - Roughness used for the internal GGX importance-sampling routine.
+     (Default: 0.1)
+
+ * - albedo_scale
+   - |texture| or |rgb|
+   - Optional asset albedo multiplier applied to the measured RGB response.
+     Spatial textures are evaluated at the surface interaction and clamped to
+     ``[0, 1]``. (Default: 1)
+
+This is an RGB-reconstruction companion to :ref:`measured_polarized
+<bsdf-measured_polarized>`.  The HPBRDF-2025 dataset stores many narrow spectral
+bands; rendering the full spectrally-varying pBRDF is memory heavy (~200 MB per
+band).  To produce a colour image cheaply, three single-band slices are picked
+to stand in for R/G/B and evaluated together in **one** render pass.
+
+Unlike the previous 3-pass approach (render once per band, then collapse each
+pass to a luminance scalar), this plugin keeps the three band reflectances as
+distinct channels, so ordinary (non-measured) materials in the same scene keep
+their real colour instead of collapsing to grey.
+
+Each ``filename_*`` points at a ``channels/{material}/{wavelength}.pbrdf`` file
+with the same tensor layout as :ref:`measured_polarized
+<bsdf-measured_polarized>` but with a single entry in its ``wvls`` field.  Only
+the unpolarised ``M[0,0]`` element is used (this BSDF is meant for the
+non-polarised path/RGB pass).
+
+Behaviour by variant:
+
+* **RGB variants** (``*_rgb``): channel ``c`` is returned directly as the
+  reflectance of band ``c``. RGBN variants add the bands' luminance as the
+  near-infrared lane.
+* **Spectral variants** (``*_spectral`` / ``*_spectral_polarized``): each sampled
+  wavelength is mapped to the nearest of the three bands, reconstructing a
+  piecewise-constant 3-band spectrum that the film integrates back to RGB.
+
+.. code-tab:: xml
+
+    <bsdf type="measured_polarized_rgb">
+        <string name="filename_r" value=".../channels/white_billiard/614.pbrdf"/>
+        <string name="filename_g" value=".../channels/white_billiard/542.pbrdf"/>
+        <string name="filename_b" value=".../channels/white_billiard/446.pbrdf"/>
+        <float name="alpha_sample" value="0.1"/>
+    </bsdf>
+*/
+template <typename Float, typename Spectrum>
+class MeasuredPolarizedRGB final : public BSDF<Float, Spectrum> {
+public:
+    MI_IMPORT_BASE(BSDF, m_flags, m_components)
+    MI_IMPORT_TYPES(Texture, MicrofacetDistribution)
+
+    using Interpolator = Marginal2D<Float, 4, true>;
+
+    MeasuredPolarizedRGB(const Properties &props) : Base(props) {
+        m_alpha_sample = props.get<ScalarFloat>("alpha_sample", 0.1f);
+        m_albedo_scale = props.get_texture<Texture>("albedo_scale", 1.f);
+
+        m_flags = BSDFFlags::GlossyReflection | BSDFFlags::FrontSide;
+        if (m_albedo_scale->is_spatially_varying())
+            m_flags = m_flags | BSDFFlags::NeedsDifferentials;
+        m_components.push_back(m_flags);
+
+        // Band order is fixed: index 0 = red, 1 = green, 2 = blue. The nominal
+        // wavelengths are read back from each file's `wvls` field.
+        const char *keys[3] = { "filename_r", "filename_g", "filename_b" };
+        load_channel(props.get<std::string_view>(keys[0]), m_interp_r, m_band_r, m_name_r);
+        load_channel(props.get<std::string_view>(keys[1]), m_interp_g, m_band_g, m_name_g);
+        load_channel(props.get<std::string_view>(keys[2]), m_interp_b, m_band_b, m_name_b);
+    }
+
+    void traverse(TraversalCallback *cb) override {
+        cb->put("albedo_scale", m_albedo_scale, ParamFlags::Differentiable);
+    }
+
+    void load_channel(std::string_view filename, Interpolator &interp,
+                      ScalarFloat &band_nm, std::string &name) {
+        auto fs = file_resolver();
+        fs::path file_path = fs->resolve(filename);
+        name = file_path.filename().string();
+
+        ref<TensorFile> tf = new TensorFile(file_path);
+
+        auto theta_h = tf->field("theta_h");
+        auto theta_d = tf->field("theta_d");
+        auto phi_d   = tf->field("phi_d");
+        auto wvls    = tf->field("wvls");
+        auto pbrdf   = tf->field("M");
+
+        if (!(theta_h.shape.size() == 2 &&
+              theta_h.dtype == sj::Type::Float32 &&
+
+              theta_d.shape.size() == 2 &&
+              theta_d.dtype == sj::Type::Float32 &&
+
+              phi_d.shape.size() == 2 &&
+              phi_d.dtype == sj::Type::Float32 &&
+
+              wvls.shape.size() == 1 &&
+              wvls.dtype == sj::Type::UInt16 &&
+
+              pbrdf.dtype == sj::Type::Float32 &&
+              pbrdf.shape.size() == 6 &&
+              pbrdf.shape[0] == phi_d.shape[1] &&
+              pbrdf.shape[1] == theta_d.shape[1] &&
+              pbrdf.shape[2] == theta_h.shape[1] &&
+              pbrdf.shape[3] == wvls.shape[0]) &&
+              pbrdf.shape[4] == 4 &&
+              pbrdf.shape[5] == 4) {
+            Throw("Invalid file structure: %s", tf->to_string());
+        }
+
+        ScalarFloat *wavelengths = new ScalarFloat[wvls.shape[0]];
+        for (size_t i = 0; i < wvls.shape[0]; ++i)
+            wavelengths[i] = ScalarFloat(((uint16_t *) wvls.data)[i]);
+        band_nm = wavelengths[0];
+
+        interp = Interpolator(
+            (ScalarFloat *) pbrdf.data,
+            ScalarVector2u(4, 4),
+            {{ (uint32_t) phi_d.shape[1],
+               (uint32_t) theta_d.shape[1],
+               (uint32_t) theta_h.shape[1],
+               (uint32_t) wvls.shape[0] }},
+            {{ (const ScalarFloat *) phi_d.data,
+               (const ScalarFloat *) theta_d.data,
+               (const ScalarFloat *) theta_h.data,
+               (const ScalarFloat *) wavelengths }},
+            false, false
+        );
+    }
+
+    std::pair<BSDFSample3f, Spectrum> sample(const BSDFContext &ctx,
+                                             const SurfaceInteraction3f &si,
+                                             Float sample1,
+                                             const Point2f &sample2,
+                                             Mask active) const override {
+        MI_MASKED_FUNCTION(ProfilerPhase::BSDFSample, active);
+
+        Float cos_theta_i = Frame3f::cos_theta(si.wi);
+        active &= cos_theta_i > 0.f;
+
+        BSDFSample3f bs = dr::zeros<BSDFSample3f>();
+        if (unlikely(dr::none_or<false>(active) || !ctx.is_enabled(BSDFFlags::GlossyReflection)))
+            return { bs, 0.f };
+
+        MicrofacetDistribution distr(MicrofacetType::GGX,
+                                     m_alpha_sample, m_alpha_sample, true);
+
+        Float lobe_pdf_diffuse = COSINE_HEMISPHERE_PDF_WEIGHT;
+        Mask sample_diffuse    = active && sample1 < lobe_pdf_diffuse,
+             sample_microfacet = active && !sample_diffuse;
+
+        Vector3f wo_diffuse    = warp::square_to_cosine_hemisphere(sample2);
+        auto [m, unused] = distr.sample(si.wi, sample2);
+        Vector3f wo_microfacet = reflect(si.wi, m);
+
+        bs.wo[sample_diffuse]    = wo_diffuse;
+        bs.wo[sample_microfacet] = wo_microfacet;
+
+        bs.pdf = pdf(ctx, si, bs.wo, active);
+
+        bs.sampled_component = 0;
+        bs.sampled_type = +BSDFFlags::GlossyReflection;
+        bs.eta = 1.f;
+
+        Spectrum value = eval(ctx, si, bs.wo, active);
+        return { bs, dr::select(active && bs.pdf > 0, value / bs.pdf, 0.f) };
+    }
+
+    Spectrum eval(const BSDFContext &ctx, const SurfaceInteraction3f &si,
+                  const Vector3f &wo, Mask active) const override {
+        MI_MASKED_FUNCTION(ProfilerPhase::BSDFEvaluate, active);
+
+        Float cos_theta_i = Frame3f::cos_theta(si.wi),
+              cos_theta_o = Frame3f::cos_theta(wo);
+        active &= (cos_theta_i > 0.f && cos_theta_o > 0.f);
+
+        if (unlikely(dr::none_or<false>(active) || !ctx.is_enabled(BSDFFlags::GlossyReflection)))
+            return 0.f;
+
+        /* Mirror the coordinate handling of `measured_polarized`: bring both
+           directions into the standard frame and obtain the isotropic
+           Rusinkiewicz parameterization. */
+        Vector3f wo_hat = ctx.mode == TransportMode::Radiance ? wo : si.wi,
+                 wi_hat = ctx.mode == TransportMode::Radiance ? si.wi : wo;
+
+        Float phi_std = phi(wi_hat);
+        Vector3f wo_std = rotate_vector(wo_hat, Vector3f(0, 0, 1), -phi_std),
+                 wi_std = rotate_vector(wi_hat, Vector3f(0, 0, 1), -phi_std);
+
+        auto [phi_d, theta_h, theta_d] = directions_to_rusinkiewicz(wo_std, wi_std);
+
+        // Evaluate the unpolarised M[0,0] reflectance of each band.
+        Float r = eval_band(m_interp_r, m_band_r, phi_d, theta_d, theta_h, active);
+        Float g = eval_band(m_interp_g, m_band_g, phi_d, theta_d, theta_h, active);
+        Float b = eval_band(m_interp_b, m_band_b, phi_d, theta_d, theta_h, active);
+
+        UnpolarizedSpectrum intensity(0.f);
+        if constexpr (is_spectral_v<Spectrum>) {
+            // Map each sampled wavelength to its nearest band. Boundaries are the
+            // midpoints between band centres (446/542/614 -> 494, 578).
+            ScalarFloat mid_bg = 0.5f * (m_band_b + m_band_g),
+                        mid_gr = 0.5f * (m_band_g + m_band_r);
+            for (size_t k = 0; k < dr::size_v<UnpolarizedSpectrum>; ++k) {
+                Float wl = si.wavelengths[k];
+                intensity[k] = dr::select(wl < mid_bg, b,
+                               dr::select(wl < mid_gr, g, r));
+            }
+        } else if constexpr (dr::size_v<UnpolarizedSpectrum> == 3) {
+            intensity[0] = r;
+            intensity[1] = g;
+            intensity[2] = b;
+        } else if constexpr (is_rgbn_v<Spectrum>) {
+            // no near-infrared band in the data: the bands' luminance, as the RGB variant's
+            // near-infrared slot gives (the luminance of its R, G, B result)
+            intensity[0] = r;
+            intensity[1] = g;
+            intensity[2] = b;
+            intensity[3] = luminance(Color3f(r, g, b));
+        } else {
+            // Monochrome fallback: average the three bands.
+            intensity = (r + g + b) * (1.f / 3.f);
+        }
+
+        auto albedo_scale = m_albedo_scale->eval(si, active);
+        albedo_scale = dr::minimum(dr::maximum(albedo_scale, 0.f), 1.f);
+        intensity *= albedo_scale;
+
+        Spectrum value;
+        if constexpr (is_polarized_v<Spectrum>) {
+            // Non-polarised (depolarising) response: intensity in the (0,0)
+            // Mueller element, everything else zero.
+            value = dr::zeros<Spectrum>();
+            value(0, 0) = intensity;
+        } else {
+            value = intensity;
+        }
+
+        return (value * cos_theta_o) & active;
+    }
+
+    Float pdf(const BSDFContext &ctx, const SurfaceInteraction3f &si,
+              const Vector3f &wo, Mask active) const override {
+        MI_MASKED_FUNCTION(ProfilerPhase::BSDFEvaluate, active);
+
+        if (unlikely(dr::none_or<false>(active) || !ctx.is_enabled(BSDFFlags::GlossyReflection)))
+            return 0.f;
+
+        Float cos_theta_i = Frame3f::cos_theta(si.wi),
+              cos_theta_o = Frame3f::cos_theta(wo);
+
+        MicrofacetDistribution distr(MicrofacetType::GGX,
+                                     m_alpha_sample, m_alpha_sample, true);
+
+        Vector3f H = dr::normalize(wo + si.wi);
+
+        Float pdf_diffuse = warp::square_to_cosine_hemisphere_pdf(wo);
+        Float pdf_microfacet = distr.pdf(si.wi, H) / (4.f * dr::dot(wo, H));
+
+        Float pdf = 0.f;
+        pdf += pdf_diffuse * COSINE_HEMISPHERE_PDF_WEIGHT;
+        pdf += pdf_microfacet * (1.f - COSINE_HEMISPHERE_PDF_WEIGHT);
+
+        return dr::select(cos_theta_i > 0.f && cos_theta_o > 0.f, pdf, 0.f);
+    }
+
+    std::string to_string() const override {
+        std::ostringstream oss;
+        oss << "MeasuredPolarizedRGB[" << std::endl
+            << "  filename_r = " << m_name_r << " (" << m_band_r << " nm)" << std::endl
+            << "  filename_g = " << m_name_g << " (" << m_band_g << " nm)" << std::endl
+            << "  filename_b = " << m_name_b << " (" << m_band_b << " nm)" << std::endl
+            << "]";
+        return oss.str();
+    }
+
+private:
+    Float eval_band(const Interpolator &interp, ScalarFloat band_nm,
+                    const Float &phi_d, const Float &theta_d, const Float &theta_h,
+                    Mask active) const {
+        Float params[4] = { phi_d, theta_d, theta_h, Float(band_nm) };
+        // Point2f(0,0) selects the (0,0) Mueller element = unpolarised intensity.
+        Float v = interp.eval(Point2f(0.f, 0.f), params, active);
+        // Invalid configurations are encoded as NaNs in the dataset.
+        dr::masked(v, dr::isnan(v)) = 0.f;
+        return dr::maximum(0.f, v);
+    }
+
+    template <typename Vector3,
+              typename Value = dr::value_t<Vector3>>
+    Value phi(const Vector3 &v) const {
+        Value p = dr::atan2(v.y(), v.x());
+        dr::masked(p, p < 0) += 2.f * dr::Pi<Float>;
+        return p;
+    }
+
+    template <typename Vector3, typename Value = dr::value_t<Vector3>>
+    MI_INLINE
+    Vector3 rotate_vector(const Vector3 &v, const Vector3 &axis_, Value angle) const {
+        Vector3 axis = dr::normalize(axis_);
+        auto [sin_angle, cos_angle] = dr::sincos(angle);
+        return v * cos_angle + axis * dr::dot(v, axis) * (1.f - cos_angle) + sin_angle * dr::cross(axis, v);
+    }
+
+    template <typename Vector3, typename Value = dr::value_t<Vector3>>
+    MI_INLINE
+    std::tuple<Value, Value, Value> directions_to_rusinkiewicz(const Vector3 &i, const Vector3 &o) const {
+        Vector3 h = dr::normalize(i + o);
+
+        Vector3 n(0, 0, 1);
+        Vector3 b = dr::normalize(dr::cross(n, h)),
+                t = dr::normalize(dr::cross(b, h));
+
+        Value td = dr::safe_acos(dr::dot(h, i)),
+              th = dr::safe_acos(dr::dot(n, h));
+
+        Vector3 i_prj = dr::normalize(i - dr::dot(i, h) * h);
+        Value cos_phi_d = dr::clip(dr::dot(t, i_prj), -1.f, 1.f),
+              sin_phi_d = dr::clip(dr::dot(b, i_prj), -1.f, 1.f);
+
+        Value pd = dr::atan2(sin_phi_d, cos_phi_d);
+
+        return std::make_tuple(pd, th, td);
+    }
+
+    MI_DECLARE_CLASS(MeasuredPolarizedRGB)
+private:
+    std::string m_name_r, m_name_g, m_name_b;
+    ScalarFloat m_band_r, m_band_g, m_band_b;
+    ScalarFloat m_alpha_sample;
+    ref<Texture> m_albedo_scale;
+    Interpolator m_interp_r, m_interp_g, m_interp_b;
+
+    MI_TRAVERSE_CB(Base, m_interp_r, m_interp_g, m_interp_b, m_albedo_scale)
+};
+
+MI_EXPORT_PLUGIN(MeasuredPolarizedRGB)
+NAMESPACE_END(mitsuba)
