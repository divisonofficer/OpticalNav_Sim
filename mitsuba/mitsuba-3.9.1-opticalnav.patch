+ * ``dot(max(c, 1 - c), [0.229, 0.587, 0.114])`` of ``c = clip(rgb, 0, 1)``
+ * (robomituba's ``pseudo_nir_albedo``).
+ */
+template <typename Float> Float pseudo_nir(const Color<Float, 3> &rgb) {
+    using F = dr::scalar_t<Float>;
+    Color<Float, 3> c = dr::clip(rgb, F(0.f), F(1.f));
+    Color<Float, 3> m = dr::maximum(c, F(1.f) - c);
+    return m[0] * F(0.229f) + m[1] * F(0.587f) + m[2] * F(0.114f);
+}
